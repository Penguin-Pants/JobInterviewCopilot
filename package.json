{
  "name": "interview-copilot",
  "version": "0.1.0",
  "description": "Real-time glanceable interview cues from your own notes. Windows desktop accessibility aid.",
  "private": true,
  "license": "MIT",
  "author": "Interview CoPilot",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --win --x64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "licenses": "node scripts/check-licenses.mjs",
    "trace": "python3 scripts/traceability.py",
    "smoke:main": "node scripts/smoke-main.cjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "check:packaged": "node scripts/check-packaged.mjs",
    "check:release": "node scripts/check-release-record.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^5.0.0",
    "electron-store": "^11.0.2",
    "framer-motion": "^13.4.0",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
